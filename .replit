modules = ["nodejs-24"]
[nix]
    channel = "stable-25_05"

    [deployment]
    run = ["sh", "-c", "NODE_ENV=production npx tsx server.ts"]
    build = ["sh", "-c", "npm run build"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 5050
externalPort = 3000
    